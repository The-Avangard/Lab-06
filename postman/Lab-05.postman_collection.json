      "item": [
        {
          "name": "Products — list and save an existing ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "products"
              ]
            }
          },
          "event": [
            {
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is JSON\", () => pm.response.to.be.json);",
                  "const products = pm.response.json();",
                  "pm.expect(products).to.be.an(\"array\");",
                  "pm.expect(products.length).to.be.above(0);",
                  "pm.collectionVariables.set(\"existing_product_id\", String(products[0].id));"
                ]
              },
              "listen": "test"
            }
          ]
